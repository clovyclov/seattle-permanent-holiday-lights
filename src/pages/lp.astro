    <section class="py-16 sm:py-20 bg-slate-50 border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-sm font-heading font-extrabold uppercase tracking-widest text-amber-700 block mb-2">
            What Your Neighbors Say
          </span>
          <h2 class="font-heading font-black text-2xl sm:text-4xl text-slate-900 leading-tight">
            "I Wish We Had Done This Five Years Ago."
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {reviews.map((rev) => (
            <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm flex flex-col justify-between space-y-5">
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <div class="flex text-amber-500">
                    {Array.from({ length: 5 }).map(() => (
                      <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    ))}
                  </div>
                  <span class="text-xs font-heading font-bold uppercase tracking-wider bg-slate-100 text-slate-700 px-2.5 py-1 rounded">
                    {rev.highlight}
                  </span>
                </div>

                <p class="text-lg text-slate-700 leading-relaxed">
                  "{rev.quote}"
                </p>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-base">
                <strong class="font-heading text-slate-900">{rev.author}</strong>
                <span class="text-slate-500 text-sm font-semibold">{rev.location} · Verified Homeowner</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- =====================================================================
         11. FAQ ACCORDION (All 8 Buyer Objections Answered Directly)
    ====================================================================== -->
    <section class="py-16 sm:py-20 bg-white border-b border-slate-200">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <span class="text-sm font-heading font-extrabold uppercase tracking-widest text-amber-700 block mb-2">
            Straight Answers
          </span>
          <h2 class="font-heading font-black text-2xl sm:text-4xl text-slate-900 leading-tight">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="space-y-4">
          {faqs.map((item, index) => (
            <details 
              class="group bg-slate-50 rounded-xl border border-slate-200 overflow-hidden transition-all"
              open={index === 0}
            >
              <summary class="flex items-center justify-between gap-4 p-5 sm:p-6 cursor-pointer list-none font-heading font-extrabold text-lg sm:text-xl text-slate-900 hover:text-amber-700">
                <span>{item.q}</span>
                <span class="w-8 h-8 rounded-lg bg-white border border-slate-300 flex items-center justify-center text-slate-700 shrink-0 transition-transform group-open:rotate-180">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="px-5 sm:px-6 pb-6 pt-1 text-lg text-slate-700 leading-relaxed border-t border-slate-200/70">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- =====================================================================
         12. URGENCY + FINAL CTA (Repeat Short Form + Click-to-Call)
    ====================================================================== -->
    <section class="py-16 sm:py-20 bg-[#071324] text-white relative overflow-hidden">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <!-- Left: Urgency & Direct Phone Option -->
          <div class="lg:col-span-6 space-y-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/20 border border-amber-400/50 text-amber-300 text-sm font-bold">
              <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Pre-Holiday Schedule Update</span>
            </div>

            <h2 class="font-heading font-black text-3xl sm:text-4xl text-white leading-tight">
              Christmas Install Dates Fill Up by {placeholders.cutoffDate}. Lock In Your Spot.
            </h2>

            <p class="text-lg text-slate-300 leading-relaxed">
              Because our crew custom-fits every home in a single day without cutting corners, we can only take a set number of homes before December. Request your free quote today to see our next open install dates.
            </p>

            <div class="bg-slate-900/90 border border-slate-700 rounded-xl p-5 space-y-3">
              <p class="text-sm uppercase tracking-wider font-heading font-bold text-amber-400">
                Prefer to talk to a person right now?
              </p>
              <a href={phoneHref} class="inline-flex items-center gap-3 text-2xl sm:text-3xl font-heading font-black text-white hover:text-amber-400 transition-colors">
                <svg class="w-7 h-7 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>{phoneDisplay}</span>
              </a>
              <p class="text-sm text-slate-400">
                Monday – Saturday, 7:00 AM – 7:00 PM · Local Seattle & Snohomish County Estimators
              </p>
            </div>
          </div>

          <!-- Right: Repeated Short Quote Form -->
          <div class="lg:col-span-6">
            <div class="bg-white text-slate-900 rounded-2xl p-6 sm:p-8 shadow-2xl border-2 border-amber-400/80">
              <h3 class="font-heading font-black text-2xl text-slate-900 mb-1">
                Get My Free Quote
              </h3>
              <p class="text-base text-slate-600 mb-5">
                Takes 30 seconds. Our owner will call or text you with an honest price range for your home.
              </p>

              <form 
                class="lead-quote-form space-y-4"
              >
                <div>
                  <label for="bottom-name" class="block text-sm font-bold text-slate-800 mb-1">Your Name *</label>
                  <input 
                    type="text" 
                    id="bottom-name" 
                    name="name" 
                    required 
                    placeholder="First and last name"
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 text-base focus:border-amber-500 focus:outline-none"
                  />
                </div>

                <div>
                  <label for="bottom-phone" class="block text-sm font-bold text-slate-800 mb-1">Phone Number *</label>
                  <input 
                    type="tel" 
                    id="bottom-phone" 
                    name="phone" 
                    required 
                    placeholder="(425) 599-6702"
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 text-base focus:border-amber-500 focus:outline-none"
                  />
                </div>

                <div>
                  <label for="bottom-city" class="block text-sm font-bold text-slate-800 mb-1">City *</label>
                  <input 
                    type="text" 
                    id="bottom-city" 
                    name="city" 
                    required 
                    placeholder="e.g. Mill Creek, Bothell, Seattle"
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 text-base focus:border-amber-500 focus:outline-none"
                  />
                </div>

                <div>
                  <label for="bottom-size" class="block text-sm font-bold text-slate-800 mb-1">Approx. Home Size *</label>
                  <select 
                    id="bottom-size" 
                    name="home_size"
                    required
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 bg-white text-slate-900 text-base focus:border-amber-500 focus:outline-none"
                  >
                    <option value="">Select stories / size...</option>
                    <option value="1-story">1-Story Home (Rambler)</option>
                    <option value="2-story">2-Story Home</option>
                    <option value="2-story-steep">2-Story with Steep Peaks / Walkout</option>
                    <option value="3-story">3-Story Home</option>
                  </select>
                </div>

                <button 
                  type="submit" 
                  class="btn-amber w-full py-4 px-6 rounded-xl text-lg uppercase tracking-wide cursor-pointer flex items-center justify-center gap-2"
                >
                  <span>Get My Free Quote</span>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
              </form>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =====================================================================
         13. FOOTER: Minimal Compliance Footer (No Outbound Distraction Links)
    ====================================================================== -->
    <footer class="bg-slate-950 text-slate-400 py-10 border-t border-slate-800 text-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <div class="space-y-1">
          <p class="font-heading font-bold text-white uppercase tracking-wide">
            {companyName} LLC
          </p>
          <p>
            {placeholders.streetAddress} · <a href={phoneHref} class="text-amber-400 hover:underline font-bold">{phoneDisplay}</a> · {placeholders.licenseNumber}
          </p>
          <p class="text-xs text-slate-500">
            Serving Seattle, Mill Creek, Bothell, Woodinville, Kirkland, Bellevue, Everett, Edmonds, Lynnwood, Marysville, Snohomish & Arlington.
          </p>
        </div>

        <div class="text-xs text-slate-500 space-x-4 shrink-0">
          <span>© {new Date().getFullYear()} {companyName}</span>
          <a href="#privacy" onclick="event.preventDefault(); alert('Privacy Policy: Your contact information is used solely to provide your lighting estimate and is never sold or shared with third parties.');" class="hover:text-slate-300 underline">
            Privacy Policy
          </a>
        </div>
      </div>
    </footer>

    <!-- =====================================================================
         MOBILE STICKY CLICK-TO-CALL + QUOTE BAR
    ====================================================================== -->
    <div class="fixed bottom-0 inset-x-0 z-50 md:hidden bg-[#071324] border-t border-slate-700 p-2.5 shadow-2xl grid grid-cols-2 gap-2.5">
      <a 
        href={phoneHref}
        class="flex items-center justify-center gap-2 py-3 px-3 rounded-lg bg-slate-800 text-white font-heading font-extrabold text-sm uppercase border border-slate-600"
      >
        <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Call Now</span>
      </a>
      <a 
        href="#top-quote"
        class="btn-amber flex items-center justify-center py-3 px-3 rounded-lg text-sm uppercase tracking-wide"
      >
        Get Free Quote
      </a>
    </div>

    <!-- Interactive Day vs. Night Slider & Lead Webhook Submission Script -->
    <script is:inline>
      (function() {
        var input = document.getElementById('slider-input');
        var overlay = document.getElementById('day-overlay');
        var line = document.getElementById('slider-line');
        if (input && overlay && line) {
          input.addEventListener('input', function(e) {
            var val = e.target.value;
            overlay.style.clipPath = 'inset(0 ' + (100 - val) + '% 0 0)';
            line.style.left = val + '%';
          });
        }

        var WEBHOOK_URL = 'https://services.leadconnectorhq.com/hooks/TgmskugdRQEpf4Ul8YFr/webhook-trigger/be17e74b-c14a-4154-aad7-c290d27c9352';
        var forms = document.querySelectorAll('.lead-quote-form');
        var urlParams = new URLSearchParams(window.location.search);

        forms.forEach(function(form) {
          form.addEventListener('submit', function(e) {
            e.preventDefault();

            var submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.innerHTML = '<span>Sending Request...</span>';
            }

            var formData = new FormData(form);
            var fullName = (formData.get('name') || '').toString().trim();
            var nameParts = fullName.split(/\s+/);
            var firstName = nameParts[0] || '';
            var lastName = nameParts.slice(1).join(' ') || '';

            var payload = {
              name: fullName,
              first_name: firstName,
              last_name: lastName,
              phone: (formData.get('phone') || '').toString().trim(),
              city: (formData.get('city') || '').toString().trim(),
              home_size: (formData.get('home_size') || '').toString().trim(),
              source: 'Google Ads Landing Page (/lp)',
              page_url: window.location.href,
              utm_source: urlParams.get('utm_source') || '',
              utm_medium: urlParams.get('utm_medium') || '',
              utm_campaign: urlParams.get('utm_campaign') || '',
              utm_term: urlParams.get('utm_term') || '',
              utm_content: urlParams.get('utm_content') || '',
              gclid: urlParams.get('gclid') || '',
              submitted_at: new Date().toISOString()
            };

            fetch(WEBHOOK_URL, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(payload),
              keepalive: true
            })
              .catch(function() {
                // Fallback to URLSearchParams simple request if JSON preflight is blocked by a browser extension
                try {
                  var formParams = new URLSearchParams();
                  Object.keys(payload).forEach(function(k) {
                    formParams.append(k, payload[k]);
                  });
                  if (navigator.sendBeacon) {
                    navigator.sendBeacon(WEBHOOK_URL, formParams);
                  }
                } catch (err) {}
              })
              .finally(function() {
                var redirectUrl = '/thank-you';
                if (firstName) {
                  redirectUrl += '?name=' + encodeURIComponent(firstName);
                }
                window.location.href = redirectUrl;
              });
          });
        });
      })();
    </script>

  </body>
</html>
