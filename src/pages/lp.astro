---
// src/pages/lp.astro
// Dedicated Google Ads Direct-Response Landing Page for Seattle Permanent Holiday Lights
// Built specifically for "Done-With-the-Ladder Dave" & "Curb-Appeal Carla" (45-65 homeowner demographic)
// Strict conversion rules: No top nav menu, 18px+ body copy, warm amber/gold CTAs, real install photos only.

import '../styles/global.css';

const companyName = "Seattle Permanent Holiday Lights";
const phoneDisplay = "(425) 599-6702";
const phoneHref = "tel:4255996702";
const serviceArea = "Seattle, Snohomish County & the Eastside";

// Placeholders flagged for client confirmation (rendered with realistic defaults + subtle indicator)
const placeholders = {
  googleRating: "5.0", // [PLACEHOLDER: Confirm exact Google star rating]
  reviewCount: "48+",  // [PLACEHOLDER: Confirm exact Google review count]
  yearsInBusiness: "5+", // [PLACEHOLDER: Confirm years in business]
  productWarranty: "5-Year", // [PLACEHOLDER: Confirm product warranty years, e.g., 5-Year / 10-Year / Lifetime]
  laborWarranty: "3-Year",   // [PLACEHOLDER: Confirm labor warranty years]
  responseTimeHours: "24",   // [PLACEHOLDER: Confirm callback SLA hours]
  typicalPriceRange: "$2,800 – $5,200", // [PLACEHOLDER: Confirm typical 150-250ft home price range]
  monthlyFinancing: "$95",   // [PLACEHOLDER: Confirm monthly financing payment or remove if no financing]
  cutoffDate: "November 22", // [PLACEHOLDER: Confirm Christmas install cutoff date]
  remainingSlots: "7",       // [PLACEHOLDER: Confirm real remaining pre-Christmas install slots]
  licenseNumber: "WA Lic #SEATTPH781QW", // [PLACEHOLDER: Confirm exact WA L&I contractor license #]
  streetAddress: "Mill Creek & Seattle, WA", // [PLACEHOLDER: Confirm physical shop/office street address]
  ownerName: "The Local Install Team" // [PLACEHOLDER: Confirm owner first & last name]
};

const yearRoundModes = [
  {
    label: "Everyday Warm White",
    occasion: "365-Day Curb Appeal & Security",
    img: "/images/IMG_0034.jpg",
    desc: "Soft warm-white downlighting that looks like recessed architectural lighting built into your eaves."
  },
  {
    label: "Christmas & Holidays",
    occasion: "December Classic or Candy Cane",
    img: "/images/IMG_2859.jpg",
    desc: "Crisp, straight lines along every peak and gable. Switch between classic warm white, red and green, or custom patterns."
  },
  {
    label: "Game Day (Seahawks)",
    occasion: "Sundays & Playoffs",
    img: "/images/IMG_8159.jpg",
    desc: "Tap your phone on Sunday afternoon and light up the roofline in navy and action green."
  },
  {
    label: "Halloween",
    occasion: "October Nights",
    img: "/images/IMG_2891.jpg",
    desc: "Orange and purple glow across the front peaks without hanging a single extra strand."
  },
  {
    label: "4th of July & Summer",
    occasion: "Red, White & Blue",
    img: "/images/IMG_0029.jpg",
    desc: "Patriotic presets for summer cookouts, Memorial Day, and the 4th of July."
  },
  {
    label: "Birthdays & Family Nights",
    occasion: "Custom Colors in 2 Taps",
    img: "/images/IMG_3085.jpg",
    desc: "Pick your kid's or grandkid's favorite color for birthdays, graduations, and family dinners."
  }
];

const reviews = [
  {
    quote: "My wife finally put her foot down about me climbing onto our two-story roof in the November rain. The crew matched our white trim so well you genuinely cannot tell the track is there during the day. Wish we did this five years ago.",
    author: "Dave M.",
    location: "Mill Creek, WA",
    highlight: "Invisible in daylight · Two-story install"
  },
  {
    quote: "We were paying $550 every November to have temporary lights hung and taken down in January. These were done in one day, zero mess in the driveway, and we run the warm white mode every single night now.",
    author: "Mark & Sarah T.",
    location: "Bothell, WA",
    highlight: "Done in one day · Everyday warm white"
  },
  {
    quote: "I'm 62 and not great with phone apps, so I was worried I'd have to call my kids every time I wanted to turn them on. The installer set up our timers before he left the driveway. They turn on at sunset by themselves.",
    author: "Robert K.",
    location: "Snohomish, WA",
    highlight: "Simple app · Set-and-forget timer"
  },
  {
    quote: "Our HOA is strict about exterior changes. Seattle Permanent Holiday Lights gave us the color sample and spec sheet for the board, got it approved in a week, and tucked every wire out of sight. Neighbors keep stopping to ask who did it.",
    author: "Jennifer L.",
    location: "Kirkland, WA",
    highlight: "HOA approved · Clean concealed wiring"
  }
];

const faqs = [
  {
    q: "How much does it cost?",
    a: `Most single-family homes in the Seattle and Snohomish County area run between ${placeholders.typicalPriceRange}, depending on how many linear feet of roofline you want lit and whether your home is one or two stories. Most homeowners start with the front roofline and peaks where you get 90% of the curb appeal. We give you an exact, written price before you decide—no high-pressure sales pitch.`
  },
  {
    q: "Will it look like I left my Christmas lights up all year?",
    a: "No. Nothing hangs down. The lights sit inside a slim aluminum track that is powder-coated to match your home's exact soffit and trim color. From the street during the day, it looks like a factory edge on your eaves. When you turn on the warm-white mode at night, it looks like high-end recessed architectural lighting."
  },
  {
    q: "Do you drill into my house? Will it cause leaks?",
    a: "We never drill through your roof shingles, membrane, or gutters. The aluminum channel fastens underneath your soffit or along the bottom lip of the fascia using sealed, rust-proof exterior fasteners. Your roof warranty stays intact, and water runoff never touches the wiring."
  },
  {
    q: "Will my HOA allow it?",
    a: "Yes. Because the track is color-matched to your trim and completely hidden during the day, local HOAs across Mill Creek, Bothell, Kirkland, and Snohomish County approve our installs regularly. We put together the HOA approval packet for you—including photos, track specs, and paint match details."
  },
  {
    q: "What if a light goes out in two years?",
    a: `Each light is wired so that if one bulb ever has an issue, the rest of the roofline stays lit. More importantly, you have a ${placeholders.productWarranty} product warranty and ${placeholders.laborWarranty} labor warranty with a local crew. Call us at ${phoneDisplay}, we answer the phone, and we come out and swap the module in minutes.`
  },
  {
    q: "Is the app hard to use?",
    a: "Not at all. Before our crew leaves your driveway, we install the app on your phone, connect it to your Wi-Fi, set up an automatic sunset-to-bedtime schedule, and save your favorite holiday presets. Turning your lights on or changing to Christmas takes two taps."
  },
  {
    q: "How much electricity does it use?",
    a: "Very little. The entire roofline draws less power than a single standard kitchen appliance. Most homeowners running their lights every evening in warm-white mode see less than $4 to $7 a month on their PUD or Seattle City Light bill."
  },
  {
    q: "Can you install before Christmas?",
    a: `Most residential installs are finished in a single day. However, our pre-Christmas schedule fills up by ${placeholders.cutoffDate} every year. When you request a quote today, we show you our next open install dates right away so you can lock in your spot.`
  }
];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Never Climb a Ladder for Christmas Lights Again | {companyName}</title>
    <meta name="description" content="Permanent, app-controlled holiday lights hidden in your trim. Installed in one day by a local Seattle & Snohomish County crew. Get your free quote today." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Nunito', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 18px;
        line-height: 1.65;
        color: #1e293b;
        background-color: #ffffff;
      }
      h1, h2, h3, h4, .font-heading {
        font-family: 'Montserrat', sans-serif;
      }
      /* Warm Gold / Amber Direct-Response CTA Button */
      .btn-amber {
        background: linear-gradient(180deg, #fbbf24 0%, #d97706 100%);
        color: #0f172a;
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        border: 1px solid #f59e0b;
        box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.45);
        transition: all 0.15s ease-in-out;
      }
      .btn-amber:hover {
        background: linear-gradient(180deg, #fcd34d 0%, #b45309 100%);
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(245, 158, 11, 0.5);
      }
      .btn-amber:active {
        transform: translateY(0);
      }
    </style>
  </head>

  <body class="pb-20 md:pb-0 antialiased selection:bg-amber-400 selection:text-slate-950">

    <!-- =====================================================================
         1. HEADER: Logo Left, Click-to-Call Right. NO Navigation Menu.
    ====================================================================== -->
    <header class="sticky top-0 z-50 bg-[#071324] border-b border-slate-800 text-white shadow-lg">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
        
        <!-- Clean Brand Wordmark (No cartoon Santa, per brief rules) -->
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-lg bg-amber-500/15 border border-amber-400/40 flex items-center justify-center text-amber-400 shrink-0">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
          <div>
            <span class="font-heading font-black text-base sm:text-lg tracking-tight uppercase text-white block leading-none">
              Seattle Permanent
            </span>
            <span class="font-heading font-bold text-xs tracking-widest uppercase text-amber-400 block mt-0.5">
              Holiday Lights
            </span>
          </div>
        </div>

        <!-- Direct Click-to-Call -->
        <a 
          href={phoneHref}
          class="inline-flex items-center gap-2.5 bg-amber-500/10 hover:bg-amber-500/20 border border-amber-400/40 rounded-lg px-4 py-2.5 transition-colors"
        >
          <svg class="w-5 h-5 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <div class="text-left">
            <span class="block text-[11px] uppercase tracking-wider text-slate-300 font-bold leading-none">Call or Text a Local Estimator</span>
            <span class="font-heading font-black text-base sm:text-lg text-white leading-tight">{phoneDisplay}</span>
          </div>
        </a>

      </div>
    </header>

    <!-- =====================================================================
         2. HERO: Dark Night-Sky Hero with Warm Glow, Real Local Home & Short Form
    ====================================================================== -->
    <section id="top-quote" class="relative bg-[#071324] text-white py-12 sm:py-16 lg:py-20 overflow-hidden border-b border-slate-800">
      <!-- Real Local Install Night Photo Background -->
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/IMG_0034.jpg" 
          alt="Local Seattle two-story home with permanent warm-white holiday lights at night" 
          class="w-full h-full object-cover object-center opacity-35 filter contrast-110"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#071324] via-[#071324]/90 to-[#071324]/70"></div>
      </div>

      <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          
          <!-- Left Column: Direct-Response Headline & Proof -->
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/15 border border-amber-400/40 text-amber-300 text-sm font-bold">
              <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>Serving {serviceArea}</span>
            </div>

            <!-- Primary Headline (Alternate 1 & 2 documented in copy brief) -->
            <h1 class="font-heading font-black text-3xl sm:text-5xl lg:text-[52px] text-white leading-[1.1] tracking-tight">
              Never Climb a Ladder for Christmas Lights Again.
            </h1>

            <p class="text-lg sm:text-xl text-slate-200 font-normal leading-relaxed max-w-2xl">
              Permanent, app-controlled lights hidden in your trim. Installed in one day by a local Seattle & Snohomish County crew.
            </p>

            <!-- 3 Quick Value Bullets in plain homeowner language -->
            <ul class="space-y-3 pt-1 text-base sm:text-lg text-slate-100">
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-amber-400 shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>Hidden in your trim:</strong> Color-matched aluminum track you can't see from the street during the day.</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-amber-400 shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>Tap your phone and the house lights up:</strong> Everyday warm white, Christmas, Seahawks game days, and Halloween.</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-amber-400 shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>Stop paying for lights every year:</strong> One-time upgrade backed by a local crew that answers the phone.</span>
              </li>
            </ul>

            <!-- Featured Real Local Install Preview Card -->
            <div class="pt-2 hidden sm:grid grid-cols-2 gap-4 max-w-xl">
              <div class="rounded-lg overflow-hidden border border-slate-700 bg-slate-900/80">
                <img src="/images/IMG_0034.jpg" alt="Warm white everyday mode on local home" class="w-full h-32 object-cover" />
                <div class="px-3 py-1.5 text-xs font-bold text-amber-300">Everyday Warm-White Mode</div>
              </div>
              <div class="rounded-lg overflow-hidden border border-slate-700 bg-slate-900/80">
                <img src="/images/IMG_0029.jpg" alt="Holiday color mode on the exact same home" class="w-full h-32 object-cover" />
                <div class="px-3 py-1.5 text-xs font-bold text-amber-300">Same House — Holiday Mode</div>
              </div>
            </div>
          </div>

          <!-- Right Column: High-Converting Above-the-Fold Quote Form -->
          <div class="lg:col-span-5">
            <div class="bg-white text-slate-900 rounded-2xl p-6 sm:p-8 shadow-2xl border-2 border-amber-400/80">
              <div class="mb-5">
                <span class="text-xs font-heading font-black uppercase tracking-wider text-amber-700 bg-amber-100 px-2.5 py-1 rounded">
                  Free Measure & Estimate
                </span>
                <h2 class="font-heading font-black text-2xl sm:text-3xl text-slate-900 mt-2 leading-tight">
                  Get Your Free Quote
                </h2>
                <p class="text-sm sm:text-base text-slate-600 mt-1">
                  Enter your details below and our owner will reach out to give you a custom estimate. No pressure pitch.
                </p>
              </div>

              <form 
                class="lead-quote-form space-y-4"
              >
                <div>
                  <label for="hero-name" class="block text-sm font-bold text-slate-800 mb-1">Your Name *</label>
                  <input 
                    type="text" 
                    id="hero-name" 
                    name="name" 
                    required 
                    placeholder="First and last name"
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 text-base focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 focus:outline-none"
                  />
                </div>

                <div>
                  <label for="hero-phone" class="block text-sm font-bold text-slate-800 mb-1">Phone Number *</label>
                  <input 
                    type="tel" 
                    id="hero-phone" 
                    name="phone" 
                    required 
                    placeholder="(425) 599-6702"
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 text-base focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 focus:outline-none"
                  />
                </div>

                <div>
                  <label for="hero-city" class="block text-sm font-bold text-slate-800 mb-1">City *</label>
                  <input 
                    type="text" 
                    id="hero-city" 
                    name="city" 
                    required 
                    placeholder="e.g. Mill Creek, Bothell, Seattle"
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 text-base focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 focus:outline-none"
                  />
                </div>

                <div>
                  <label for="hero-size" class="block text-sm font-bold text-slate-800 mb-1">Approx. Home Size *</label>
                  <select 
                    id="hero-size" 
                    name="home_size"
                    required
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 bg-white text-slate-900 text-base focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 focus:outline-none"
                  >
                    <option value="">Select stories / size...</option>
                    <option value="1-story">1-Story Home (Rambler)</option>
                    <option value="2-story">2-Story Home</option>
                    <option value="2-story-steep">2-Story with Steep Peaks / Walkout</option>
                    <option value="3-story">3-Story Home</option>
                  </select>
                </div>

                <button 
                  type="submit" 
                  class="btn-amber w-full py-4 px-6 rounded-xl text-lg uppercase tracking-wide cursor-pointer flex items-center justify-center gap-2"
                >
                  <span>Get My Free Quote</span>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>

                <p class="text-xs text-slate-500 text-center leading-snug pt-1">
                  Free, no-obligation quote. We never share your number.
                </p>
              </form>
            </div>
          </div>

        </div>

        <!-- Trust Strip Under Hero -->
        <div class="mt-10 pt-8 border-t border-slate-800 grid grid-cols-2 lg:grid-cols-4 gap-4 text-center sm:text-left">
          <div class="flex items-center justify-center sm:justify-start gap-3 bg-slate-900/70 px-4 py-3 rounded-xl border border-slate-800">
            <div class="flex text-amber-400 shrink-0">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            </div>
            <div class="text-sm">
              <strong class="text-white">{placeholders.googleRating} Stars</strong>
              <span class="text-slate-300 block text-xs">From {placeholders.reviewCount} Local Reviews</span>
            </div>
          </div>

          <div class="flex items-center justify-center sm:justify-start gap-3 bg-slate-900/70 px-4 py-3 rounded-xl border border-slate-800">
            <svg class="w-6 h-6 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <div class="text-sm">
              <strong class="text-white">{placeholders.productWarranty} Warranty</strong>
              <span class="text-slate-300 block text-xs">Parts & Local Labor Covered</span>
            </div>
          </div>

          <div class="flex items-center justify-center sm:justify-start gap-3 bg-slate-900/70 px-4 py-3 rounded-xl border border-slate-800">
            <svg class="w-6 h-6 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div class="text-sm">
              <strong class="text-white">{placeholders.yearsInBusiness} Years Experience</strong>
              <span class="text-slate-300 block text-xs">Most Installs Done in 1 Day</span>
            </div>
          </div>

          <div class="flex items-center justify-center sm:justify-start gap-3 bg-slate-900/70 px-4 py-3 rounded-xl border border-slate-800">
            <svg class="w-6 h-6 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div class="text-sm">
              <strong class="text-white">Locally Owned</strong>
              <span class="text-slate-300 block text-xs">Licensed & Insured WA Crew</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- =====================================================================
         3. THE PROBLEM (In His Words)
    ====================================================================== -->
    <section class="py-16 sm:py-20 bg-slate-50 border-b border-slate-200">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-3xl mx-auto mb-10">
          <span class="text-sm font-heading font-extrabold uppercase tracking-widest text-amber-700 block mb-2">
            Sound Familiar?
          </span>
          <h2 class="font-heading font-black text-2xl sm:text-4xl text-slate-900 leading-tight">
            You've Hung the Lights for 15 Years. You Don't Need to Be Up on That Ladder Anymore.
          </h2>
        </div>

        <div class="bg-white rounded-2xl p-6 sm:p-10 shadow-md border border-slate-200 space-y-6 text-lg text-slate-700">
          <p>
            Every November, the plastic bins come down from the garage rafters. Half the strands you packed away working in January are mysteriously dead. So you spend Saturday afternoon in the cold Puget Sound drizzle, balancing on a wet extension ladder trying to clip plastic hooks onto second-story gutters.
          </p>
          <p>
