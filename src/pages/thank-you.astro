---
// src/pages/thank-you.astro
// Dedicated Lead Conversion Thank You Page (/thank-you)
// Used for Google Ads conversion tracking and immediate post-lead reassurance.

import '../styles/global.css';

const companyName = "Seattle Permanent Holiday Lights";
const phoneDisplay = "(425) 599-6702";
const phoneHref = "tel:4255996702";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thank You — We Received Your Quote Request | {companyName}</title>
    <meta name="robots" content="noindex, nofollow" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@700;800;900&display=swap"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 18px;
        line-height: 1.65;
        color: #0f172a;
        background-color: #071324;
      }
      h1, h2, h3, .font-heading {
        font-family: 'Montserrat', sans-serif;
      }
      .btn-amber {
        background: linear-gradient(180deg, #fbbf24 0%, #d97706 100%);
        color: #0f172a;
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        box-shadow: 0 10px 25px -5px rgba(245, 158, 11, 0.45);
        transition: all 0.2s ease;
      }
      .btn-amber:hover {
        background: linear-gradient(180deg, #fcd34d 0%, #f59e0b 100%);
        transform: translateY(-1px);
      }
    </style>
  </head>

  <body class="min-h-screen flex flex-col justify-between bg-[#071324] text-white antialiased selection:bg-amber-400 selection:text-slate-950">

    <!-- Minimal Header -->
    <header class="bg-[#071324]/95 border-b border-slate-800 backdrop-blur-md">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between gap-4">
        <a href="/lp" class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-amber-500/15 border border-amber-400/40 flex items-center justify-center text-amber-400 shrink-0">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 10.5L12 3l9 7.5M5 9v11a1 1 0 001 1h12a1 1 0 001-1V9" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 14h6" />
            </svg>
          </div>
          <div>
            <span class="font-heading font-black text-base sm:text-lg tracking-tight text-white block leading-none">
              SEATTLE PERMANENT
            </span>
            <span class="font-heading font-bold text-xs sm:text-sm tracking-widest text-amber-400 uppercase block mt-0.5">
              HOLIDAY LIGHTS
            </span>
          </div>
        </a>

        <a 
          href={phoneHref}
          class="inline-flex items-center gap-2 bg-amber-400 hover:bg-amber-300 text-slate-950 font-heading font-black text-sm sm:text-base px-4 py-2.5 rounded-lg shadow-md transition-colors"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>{phoneDisplay}</span>
        </a>
      </div>
    </header>

    <!-- Main Confirmation Content -->
    <main class="flex-1 py-12 sm:py-20 px-4 sm:px-6">
      <div class="max-w-3xl mx-auto">
        
        <!-- Confirmation Card -->
        <div class="bg-white text-slate-900 rounded-2xl p-6 sm:p-10 shadow-2xl border-2 border-amber-400/80 text-center">
          <div class="w-16 h-16 rounded-full bg-emerald-100 border-2 border-emerald-500 text-emerald-700 flex items-center justify-center mx-auto mb-5">
            <svg class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>

          <span class="inline-block text-xs font-heading font-black uppercase tracking-widest text-emerald-800 bg-emerald-100 px-3 py-1 rounded-full mb-3">
            Quote Request Confirmed
          </span>

          <h1 id="thank-you-heading" class="font-heading font-black text-3xl sm:text-4xl text-slate-900 leading-tight">
            Got It — We Have Your Quote Request.
          </h1>

          <p class="text-lg text-slate-600 mt-3 max-w-xl mx-auto leading-relaxed">
            Our owner has been notified and will call or text you shortly from <strong class="text-slate-900">(425) 330-6240</strong> to go over your home and give you an honest price range.
          </p>

          <!-- What Happens Next (3 Steps) -->
          <div class="mt-8 pt-8 border-t border-slate-200 text-left">
            <h2 class="font-heading font-black text-lg uppercase tracking-wider text-slate-900 text-center mb-6">
              What Happens Next
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              <div class="bg-slate-50 rounded-xl p-5 border border-slate-200">
                <div class="w-8 h-8 rounded-lg bg-amber-400 text-slate-950 font-heading font-black text-sm flex items-center justify-center mb-3">
                  1
                </div>
                <h3 class="font-heading font-extrabold text-base text-slate-900">
                  Quick Call or Text
                </h3>
                <p class="text-sm text-slate-600 mt-1 leading-relaxed">
                  Watch for a call or text from <strong>(425) 330-6240</strong>. We'll answer your initial questions right away.
                </p>
              </div>

              <div class="bg-slate-50 rounded-xl p-5 border border-slate-200">
                <div class="w-8 h-8 rounded-lg bg-amber-400 text-slate-950 font-heading font-black text-sm flex items-center justify-center mb-3">
                  2
                </div>
                <h3 class="font-heading font-extrabold text-base text-slate-900">
                  Photo or 15-Min Visit
                </h3>
                <p class="text-sm text-slate-600 mt-1 leading-relaxed">
                  You can text us a photo of the front of your house, or we can stop by for 15 minutes with color-matched track samples.
                </p>
              </div>

              <div class="bg-slate-50 rounded-xl p-5 border border-slate-200">
                <div class="w-8 h-8 rounded-lg bg-amber-400 text-slate-950 font-heading font-black text-sm flex items-center justify-center mb-3">
                  3
                </div>
                <h3 class="font-heading font-extrabold text-base text-slate-900">
                  Exact Written Price
                </h3>
                <p class="text-sm text-slate-600 mt-1 leading-relaxed">
                  We give you a clear, flat-rate quote good for 30 days. No pushy sales pitch.
                </p>
              </div>
            </div>
          </div>

          <!-- Helpful Tip Box -->
          <div class="mt-7 bg-amber-50 border border-amber-200 rounded-xl p-5 text-left flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-lg bg-amber-400/20 border border-amber-400/40 text-amber-800 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="font-heading font-extrabold text-sm sm:text-base text-slate-900">
                  Want an even faster quote?
                </p>
                <p class="text-sm text-slate-700 mt-0.5">
                  Snap a quick daytime photo of the front of your house so you have it ready when our owner texts you, or call us right now.
                </p>
              </div>
            </div>

            <a 
              href={phoneHref}
              class="btn-amber px-5 py-3 rounded-xl text-sm uppercase tracking-wide shrink-0 w-full sm:w-auto text-center"
            >
              Call {phoneDisplay}
            </a>
          </div>
        </div>

      </div>
    </main>

    <!-- Minimal Footer -->
    <footer class="bg-slate-950 text-slate-400 py-8 border-t border-slate-800 text-sm text-center">
      <div class="max-w-5xl mx-auto px-4">
        <p class="font-heading font-bold text-white">{companyName}</p>
        <p class="text-xs text-slate-500 mt-1">
          Serving Seattle, Snohomish County & the Eastside · <a href={phoneHref} class="text-amber-400 hover:underline">{phoneDisplay}</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      // Personalize heading if ?name= is present in URL
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var rawName = params.get('name');
          if (rawName && rawName.trim().length > 0) {
            var firstName = rawName.trim().split(' ')[0];
            var heading = document.getElementById('thank-you-heading');
            if (heading && firstName) {
              heading.textContent = 'Thanks, ' + firstName + ' — We Have Your Quote Request.';
            }
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
