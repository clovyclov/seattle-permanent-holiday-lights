---
import Layout from '../../layouts/Layout.astro';
import CallToAction from '../../components/CallToAction.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
---

<Layout 
  title="Commercial Permanent Lighting | Seattle & Puget Sound"
  description="Commercial-grade permanent roofline and architectural lighting for Seattle storefronts, office buildings, restaurants, and shopping plazas."
>
  <section class="relative min-h-[480px] flex items-center justify-center overflow-hidden bg-[#001f35] py-20">
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/IMG_1044.jpg" 
        alt="Commercial building permanent lighting" 
        class="w-full h-full object-cover filter brightness-[0.4] contrast-[1.1]"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-[#001f35]/90 via-[#001f35]/40 to-[#001f35]/90"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-[#cc181e] text-white text-xs font-['Montserrat',sans-serif] font-black uppercase tracking-wider">
        Commercial Solutions
      </div>
      <h1 class="font-['Montserrat',sans-serif] font-black text-3xl sm:text-5xl lg:text-6xl text-white uppercase tracking-tight leading-tight">
        Commercial Permanent<br class="hidden sm:block" /> Exterior Lighting
      </h1>
      <p class="text-slate-100 text-sm sm:text-lg max-w-2xl mx-auto font-medium leading-relaxed drop-shadow">
        Improve nighttime visibility, reinforce your business brand colors, and celebrate holidays automatically with commercial-grade exterior track lighting.
      </p>

      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
        <button 
          type="button" 
          data-open-quote-modal 
          class="btn-fast-quote text-sm sm:text-base px-8 py-3.5"
        >
          Get A Fast Quote
        </button>
        <a 
          href="tel:4255996702" 
          class="px-6 py-3.5 rounded bg-white/10 hover:bg-white/20 text-white font-['Montserrat',sans-serif] font-bold text-xs uppercase tracking-wider backdrop-blur-sm transition-colors border border-white/20"
        >
          Call (425) 599-6702
        </a>
      </div>
    </div>
  </section>

  <!-- Commercial Feature Cards on Light Background -->
  <section class="py-20 bg-[#f9f6f7] border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-2">
        <span class="text-xs uppercase font-['Montserrat',sans-serif] font-black tracking-widest text-[#cc181e] block">
          Storefronts & Commercial Properties
        </span>
        <h2 class="font-['Montserrat',sans-serif] font-black text-2xl sm:text-4xl text-[#002b47] uppercase tracking-tight">
          Commercial Grade Reliability & Brand Visibility
        </h2>
        <p class="text-slate-600 text-sm sm:text-base mt-2">
          Designed for retail strips, office parapets, restaurants, and commercial properties that require daily automated operation.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-7 rounded-lg border border-slate-200 shadow-sm border-t-4 border-t-[#002b47] space-y-3">
          <h3 class="font-['Montserrat',sans-serif] font-black text-lg text-[#002b47] uppercase">
            Scheduled Brand Colors
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Program your building to illuminate in your company's brand colors during business hours, switch to security illumination late at night, or highlight local sports and holidays automatically.
          </p>
        </div>

        <div class="bg-white p-7 rounded-lg border border-slate-200 shadow-sm border-t-4 border-t-[#cc181e] space-y-3">
          <h3 class="font-['Montserrat',sans-serif] font-black text-lg text-[#002b47] uppercase">
            Commercial Parapet & Fascia Fit
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Our custom aluminum channels attach securely to metal parapet copings, concrete soffits, or wood fascia. Wiring is run in concealed conduit for clean commercial aesthetics.
          </p>
        </div>

        <div class="bg-white p-7 rounded-lg border border-slate-200 shadow-sm border-t-4 border-t-emerald-600 space-y-3">
          <h3 class="font-['Montserrat',sans-serif] font-black text-lg text-[#002b47] uppercase">
            Zero Annual Maintenance
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Stop paying commercial lift rental fees and contractor crews every November to hang temporary lights and take them down in January. A single install runs for years.
          </p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <button 
          type="button" 
          data-open-quote-modal 
          class="btn-fast-quote text-xs py-3 px-8"
        >
          Request Commercial Proposal
        </button>
      </div>
    </div>
  </section>

  <FaqAccordion />
  <CallToAction />
</Layout>
