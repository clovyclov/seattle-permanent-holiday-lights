---
import Layout from '../layouts/Layout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
---

<Layout 
  title="Contact Us | Seattle Permanent Holiday Lights"
  description="Contact Seattle Permanent Holiday Lights for a free upfront quote on custom exterior LED lighting. Call (425) 599-6702 or submit our online request form."
>
  <section class="py-16 bg-slate-900 border-b border-slate-800 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-red-600/10 border border-red-500/30 text-red-400 text-xs font-bold uppercase tracking-wider">
        Get In Touch
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tight">
        Contact Our Seattle Lighting Team
      </h1>
      <p class="text-slate-300 text-base sm:text-lg">
        We provide free onsite measurements, virtual estimates via aerial mapping, and channel color matching.
      </p>
    </div>
  </section>

  <section class="py-20 bg-slate-950 text-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Contact Details -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <h2 class="text-2xl font-black text-white uppercase tracking-tight mb-3">Direct Contact</h2>
            <p class="text-slate-300 text-sm leading-relaxed">
              Have questions about linear footage, color matching, or project scheduling? Call our local estimators directly or send an email.
            </p>
          </div>

          <div class="space-y-4">
            <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="text-xs uppercase font-extrabold text-slate-400">Direct Telephone</p>
                <a href="tel:4255996702" class="text-lg font-bold text-white hover:text-amber-400 transition-colors">
                  (425) 599-6702
                </a>
                <p class="text-xs text-slate-400 mt-0.5">Call or text for fast assistance</p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="text-xs uppercase font-extrabold text-slate-400">Email Inquiries</p>
                <a href="mailto:info@seattlepermanentholidaylights.com" class="text-sm font-bold text-white hover:text-amber-400 transition-colors">
                  info@seattlepermanentholidaylights.com
                </a>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs uppercase font-extrabold text-slate-400">Working Hours</p>
                <p class="text-sm font-bold text-white">Monday – Saturday: 7:00 AM – 7:00 PM</p>
                <p class="text-xs text-rose-400 font-semibold">Sunday: Closed</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Quote Form -->
        <div class="lg:col-span-7 bg-white border border-slate-200 rounded-xl p-6 sm:p-10 shadow-xl">
          <div class="border-b border-slate-100 pb-4 mb-6">
            <span class="text-xs uppercase font-['Montserrat',sans-serif] font-black tracking-widest text-[#cc181e] block mb-1">Upfront Honest Pricing</span>
            <h2 class="text-2xl font-['Montserrat',sans-serif] font-black text-[#002b47] uppercase tracking-tight">Request Free Roofline Estimate</h2>
            <p class="text-xs sm:text-sm text-slate-600 mt-1">
              Enter your property address and details. Our local estimators measure via satellite and on-site visits to provide an accurate quote.
            </p>
          </div>

          <form 
            id="contact-lead-form"
            class="space-y-4"
          >
            <div>
              <label for="contact-name" class="block text-xs font-['Montserrat',sans-serif] font-bold text-slate-800 uppercase tracking-wide mb-1">
                Full Name <span class="text-[#cc181e]">*</span>
              </label>
              <input 
                type="text" 
                id="contact-name" 
                name="name" 
                required 
                placeholder="Your name" 
                class="w-full px-3.5 py-2.5 rounded border border-slate-300 bg-white text-slate-900 text-sm focus:border-[#cc181e] focus:ring-1 focus:ring-[#cc181e] focus:outline-none transition-colors"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div>
                <label for="contact-phone" class="block text-xs font-['Montserrat',sans-serif] font-bold text-slate-800 uppercase tracking-wide mb-1">
                  Phone Number <span class="text-[#cc181e]">*</span>
                </label>
                <input 
                  type="tel" 
                  id="contact-phone" 
                  name="phone" 
                  required 
                  placeholder="(425) 599-6702" 
                  class="w-full px-3.5 py-2.5 rounded border border-slate-300 bg-white text-slate-900 text-sm focus:border-[#cc181e] focus:ring-1 focus:ring-[#cc181e] focus:outline-none transition-colors"
                />
              </div>
              <div>
                <label for="contact-city" class="block text-xs font-['Montserrat',sans-serif] font-bold text-slate-800 uppercase tracking-wide mb-1">
                  City <span class="text-[#cc181e]">*</span>
                </label>
                <input 
                  type="text" 
                  id="contact-city" 
                  name="city" 
                  required 
                  placeholder="e.g. Seattle, Mill Creek, Bellevue" 
                  class="w-full px-3.5 py-2.5 rounded border border-slate-300 bg-white text-slate-900 text-sm focus:border-[#cc181e] focus:ring-1 focus:ring-[#cc181e] focus:outline-none transition-colors"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div>
                <label for="contact-size" class="block text-xs font-['Montserrat',sans-serif] font-bold text-slate-800 uppercase tracking-wide mb-1">
                  Approx. Home Size <span class="text-[#cc181e]">*</span>
                </label>
                <select 
                  id="contact-size" 
                  name="home_size" 
                  required
                  class="w-full px-3.5 py-2.5 rounded border border-slate-300 bg-white text-slate-900 text-sm focus:border-[#cc181e] focus:ring-1 focus:ring-[#cc181e] focus:outline-none transition-colors cursor-pointer"
                >
                  <option value="">Select stories / size...</option>
                  <option value="1-story">1-Story Home (Rambler)</option>
                  <option value="2-story">2-Story Home</option>
                  <option value="2-story-steep">2-Story with Steep Peaks / Walkout</option>
                  <option value="3-story">3-Story Home</option>
                </select>
              </div>
              <div>
                <label for="contact-type" class="block text-xs font-['Montserrat',sans-serif] font-bold text-slate-800 uppercase tracking-wide mb-1">Installation Interest</label>
                <select 
                  id="contact-type" 
                  name="service" 
                  class="w-full px-3.5 py-2.5 rounded border border-slate-300 bg-white text-slate-900 text-sm focus:border-[#cc181e] focus:ring-1 focus:ring-[#cc181e] focus:outline-none transition-colors cursor-pointer"
                >
                  <option value="residential">Residential Permanent Lighting (Roofline & Peaks)</option>
                  <option value="commercial">Commercial Storefront / Commercial Building</option>
                  <option value="patio">Patio, Pergola or Deck Lighting</option>
                  <option value="other">Full Estate / Custom Package</option>
                </select>
              </div>
            </div>

            <div>
              <label for="contact-notes" class="block text-xs font-['Montserrat',sans-serif] font-bold text-slate-800 uppercase tracking-wide mb-1">Project Details (Optional)</label>
              <textarea 
                id="contact-notes" 
                name="notes" 
                rows="3" 
                placeholder="Mention roofline details, stories, or desired installation date..." 
                class="w-full px-3.5 py-2.5 rounded border border-slate-300 bg-white text-slate-900 text-sm focus:border-[#cc181e] focus:ring-1 focus:ring-[#cc181e] focus:outline-none transition-colors resize-none"
              ></textarea>
            </div>

            <div class="text-[11px] text-slate-600 flex items-start gap-2 leading-relaxed pt-1">
              <input type="checkbox" id="contact-consent" required checked class="mt-0.5 rounded border-slate-300 text-[#cc181e] focus:ring-0 cursor-pointer" />
              <label for="contact-consent">
                I agree to receive project quotes and text notifications from Seattle Permanent Holiday Lights at this number. Message frequency varies. Reply STOP to cancel.
              </label>
            </div>

            <button 
              type="submit" 
              class="btn-fast-quote w-full py-3.5 text-sm sm:text-base tracking-wider uppercase shadow-md cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Get A Fast Quote</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <FaqAccordion />

  <script>
    const contactForm = document.getElementById('contact-lead-form') as HTMLFormElement | null;
    if (contactForm) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const submitBtn = contactForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span>Sending Request...</span>';
        }

        const formData = new FormData(contactForm);
        const fullName = (formData.get('name') || '').toString().trim();
        const nameParts = fullName.split(/\s+/);
        const firstName = nameParts[0] || '';
        const lastName = nameParts.slice(1).join(' ') || '';
        const urlParams = new URLSearchParams(window.location.search);

        const payload = {
          name: fullName,
          first_name: firstName,
          last_name: lastName,
          phone: (formData.get('phone') || '').toString().trim(),
          city: (formData.get('city') || '').toString().trim(),
          home_size: (formData.get('home_size') || '').toString().trim(),
          service: (formData.get('service') || '').toString().trim(),
          notes: (formData.get('notes') || '').toString().trim(),
          source: 'Website Contact Page',
          page_url: window.location.href,
          utm_source: urlParams.get('utm_source') || '',
          utm_medium: urlParams.get('utm_medium') || '',
          utm_campaign: urlParams.get('utm_campaign') || '',
          utm_term: urlParams.get('utm_term') || '',
          utm_content: urlParams.get('utm_content') || '',
          gclid: urlParams.get('gclid') || '',
          submitted_at: new Date().toISOString()
        };

        fetch('https://services.leadconnectorhq.com/hooks/TgmskugdRQEpf4Ul8YFr/webhook-trigger/be17e74b-c14a-4154-aad7-c290d27c9352', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload),
          keepalive: true
        })
          .catch(() => {
            try {
              const formParams = new URLSearchParams();
              Object.entries(payload).forEach(([k, v]) => formParams.append(k, v));
              if (navigator.sendBeacon) {
                navigator.sendBeacon('https://services.leadconnectorhq.com/hooks/TgmskugdRQEpf4Ul8YFr/webhook-trigger/be17e74b-c14a-4154-aad7-c290d27c9352', formParams);
              }
            } catch (err) {}
          })
          .finally(() => {
            let redirectUrl = '/thank-you';
            if (firstName) {
              redirectUrl += '?name=' + encodeURIComponent(firstName);
            }
            window.location.href = redirectUrl;
          });
      });
    }
  </script>
</Layout>
