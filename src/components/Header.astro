---
// Header.astro - Matching exact logo, menu selections, and dropdowns from user screenshots
---

<header class="sticky top-0 z-50 w-full bg-[#002b47] border-b border-[#001f35] text-white shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo using User's Santa Hat Logo -->
      <a href="/" class="flex items-center gap-3 py-1 group">
        <img 
          src="/images/logo.png" 
          alt="Seattle Permanent Holiday Lights Logo" 
          class="h-14 sm:h-16 w-auto object-contain transition-transform group-hover:scale-105"
        />
        <div class="hidden sm:flex flex-col">
          <span class="font-['Montserrat',sans-serif] font-black text-sm sm:text-base tracking-tight uppercase text-white leading-none">
            Seattle Permanent
          </span>
          <span class="font-['Montserrat',sans-serif] font-bold text-xs tracking-wider uppercase text-slate-300 leading-tight">
            Holiday Lights
          </span>
        </div>
      </a>

      <!-- Desktop Nav Bar matching User's Exact Menu Selections -->
      <nav class="hidden lg:flex items-center gap-7 font-['Montserrat',sans-serif] text-xs font-black tracking-wider uppercase text-white">
        
        <!-- HOME -->
        <a href="/" class="hover:text-[#cc181e] transition-colors py-2">
          HOME
        </a>

        <!-- SERVICES DROPDOWN -->
        <div class="relative group">
          <button 
            type="button"
            class="flex items-center gap-1.5 py-2 hover:text-[#cc181e] group-hover:text-[#cc181e] transition-colors focus:outline-none"
            aria-expanded="false"
          >
            <span>SERVICES</span>
            <!-- Down Chevron (Default) -->
            <svg class="w-3.5 h-3.5 group-hover:hidden transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
            <!-- Up Chevron (Hover / Active) -->
            <svg class="w-3.5 h-3.5 hidden group-hover:block transition-transform text-[#cc181e]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
            </svg>
          </button>

          <!-- Dropdown Card -->
          <div class="absolute left-0 top-full pt-1 hidden group-hover:block group-focus-within:block z-50">
            <div class="w-64 bg-white text-black shadow-2xl rounded-b-md border-t-2 border-[#cc181e] py-2 overflow-hidden animate-in fade-in slide-in-from-top-1 duration-150">
              <a 
                href="/services/residential" 
                class="block px-6 py-3 text-xs sm:text-[13px] font-black uppercase text-[#0f172a] hover:text-[#cc181e] hover:bg-slate-50 transition-colors"
              >
                HOLIDAY LIGHTS
              </a>
              <a 
                href="/services/commercial" 
                class="block px-6 py-3 text-xs sm:text-[13px] font-black uppercase text-[#0f172a] hover:text-[#cc181e] hover:bg-slate-50 transition-colors border-t border-slate-100"
              >
                PERMANENT HOLIDAY LIGHT
              </a>
            </div>
          </div>
        </div>

        <!-- PROJECTS -->
        <a href="/projects" class="hover:text-[#cc181e] transition-colors py-2">
          PROJECTS
        </a>

        <!-- SERVICE AREAS DROPDOWN -->
        <div class="relative group">
          <button 
            type="button"
            class="flex items-center gap-1.5 py-2 hover:text-[#cc181e] group-hover:text-[#cc181e] transition-colors focus:outline-none"
            aria-expanded="false"
          >
            <span>SERVICE AREAS</span>
            <!-- Down Chevron (Default) -->
            <svg class="w-3.5 h-3.5 group-hover:hidden transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
            <!-- Up Chevron (Hover / Active) -->
            <svg class="w-3.5 h-3.5 hidden group-hover:block transition-transform text-[#cc181e]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
            </svg>
          </button>

          <!-- Dropdown Card -->
          <div class="absolute left-0 top-full pt-1 hidden group-hover:block group-focus-within:block z-50">
            <div class="w-60 bg-white text-black shadow-2xl rounded-b-md border-t-2 border-[#cc181e] py-2 overflow-hidden animate-in fade-in slide-in-from-top-1 duration-150">
              <a 
                href="/service-areas#seattle" 
                class="block px-6 py-2.5 text-xs sm:text-[13px] font-black uppercase text-[#0f172a] hover:text-[#cc181e] hover:bg-slate-50 transition-colors"
              >
                SEATTLE
              </a>
              <a 
                href="/service-areas#mill-creek" 
                class="block px-6 py-2.5 text-xs sm:text-[13px] font-black uppercase text-[#0f172a] hover:text-[#cc181e] hover:bg-slate-50 transition-colors"
              >
                MILL CREEK
              </a>
              <a 
                href="/service-areas#marysville" 
                class="block px-6 py-2.5 text-xs sm:text-[13px] font-black uppercase text-[#0f172a] hover:text-[#cc181e] hover:bg-slate-50 transition-colors"
              >
                MARYSVILLE
              </a>
              <a 
                href="/service-areas#bothell" 
                class="block px-6 py-2.5 text-xs sm:text-[13px] font-black uppercase text-[#0f172a] hover:text-[#cc181e] hover:bg-slate-50 transition-colors"
              >
                BOTHELL
              </a>
              <a 
                href="/service-areas#woodinville" 
                class="block px-6 py-2.5 text-xs sm:text-[13px] font-black uppercase text-[#0f172a] hover:text-[#cc181e] hover:bg-slate-50 transition-colors"
              >
                WOODENVILLE
              </a>
              <a 
                href="/service-areas#arlington" 
                class="block px-6 py-2.5 text-xs sm:text-[13px] font-black uppercase text-[#0f172a] hover:text-[#cc181e] hover:bg-slate-50 transition-colors"
              >
                ARLINGTON
              </a>
              <a 
                href="/service-areas#mount-vernon" 
                class="block px-6 py-2.5 text-xs sm:text-[13px] font-black uppercase text-[#0f172a] hover:text-[#cc181e] hover:bg-slate-50 transition-colors"
              >
                MOUNT VERNON
              </a>
              <a 
                href="/service-areas#bellingham" 
                class="block px-6 py-2.5 text-xs sm:text-[13px] font-black uppercase text-[#0f172a] hover:text-[#cc181e] hover:bg-slate-50 transition-colors"
              >
                BELINGHAM
              </a>
            </div>
          </div>
        </div>

      </nav>

      <!-- Desktop Action Buttons -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href="tel:4255996702" 
          class="hidden xl:inline-flex items-center gap-1.5 px-3 py-2 rounded text-xs font-['Montserrat',sans-serif] font-bold uppercase text-white hover:text-amber-300 transition-colors"
        >
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>(425) 599-6702</span>
        </a>

        <button 
          type="button" 
          data-open-quote-modal 
          class="btn-fast-quote text-xs py-2.5 px-5"
        >
          Get A Fast Quote
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <button 
        type="button" 
        id="nav-toggle" 
        class="lg:hidden p-2 rounded text-slate-300 hover:text-white focus:outline-none"
        aria-label="Toggle navigation"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Navigation Dropdown -->
  <div id="mobile-nav" class="hidden lg:hidden bg-[#001f35] border-t border-[#002b47] px-4 py-4 space-y-3 font-['Montserrat',sans-serif] text-xs font-bold uppercase">
    <a href="/" class="block py-2 text-white hover:text-[#cc181e]">HOME</a>
    
    <!-- Mobile Services Accordion -->
    <details class="group">
      <summary class="flex items-center justify-between py-2 text-white hover:text-[#cc181e] cursor-pointer list-none">
        <span>SERVICES</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="pl-4 pt-1 pb-2 space-y-2 border-l-2 border-[#cc181e] ml-2 text-slate-300">
        <a href="/services/residential" class="block py-1 hover:text-white">HOLIDAY LIGHTS</a>
        <a href="/services/commercial" class="block py-1 hover:text-white">PERMANENT HOLIDAY LIGHT</a>
      </div>
    </details>

    <a href="/projects" class="block py-2 text-white hover:text-[#cc181e]">PROJECTS</a>

    <!-- Mobile Service Areas Accordion -->
    <details class="group">
      <summary class="flex items-center justify-between py-2 text-white hover:text-[#cc181e] cursor-pointer list-none">
        <span>SERVICE AREAS</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="pl-4 pt-1 pb-2 space-y-2 border-l-2 border-[#cc181e] ml-2 text-slate-300">
        <a href="/service-areas#seattle" class="block py-1 hover:text-white">SEATTLE</a>
        <a href="/service-areas#mill-creek" class="block py-1 hover:text-white">MILL CREEK</a>
        <a href="/service-areas#marysville" class="block py-1 hover:text-white">MARYSVILLE</a>
        <a href="/service-areas#bothell" class="block py-1 hover:text-white">BOTHELL</a>
        <a href="/service-areas#woodinville" class="block py-1 hover:text-white">WOODENVILLE</a>
        <a href="/service-areas#arlington" class="block py-1 hover:text-white">ARLINGTON</a>
        <a href="/service-areas#mount-vernon" class="block py-1 hover:text-white">MOUNT VERNON</a>
        <a href="/service-areas#bellingham" class="block py-1 hover:text-white">BELINGHAM</a>
      </div>
    </details>

    <div class="pt-3 flex flex-col gap-2">
      <a href="tel:4255996702" class="py-2.5 px-4 rounded bg-slate-800 text-center text-white">
        Call (425) 599-6702
      </a>
      <button type="button" data-open-quote-modal class="btn-fast-quote w-full text-center">
        Get A Fast Quote
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
