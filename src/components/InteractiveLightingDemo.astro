---
// InteractiveLightingDemo.astro - Interactive smartphone app lighting simulator
---

<section id="interactive-demo" class="py-20 bg-slate-900 border-y border-slate-800 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Interactive Phone App Preview
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white uppercase tracking-tight">
        Control Every Bulb From Your Phone
      </h2>
      <p class="text-slate-300 text-base sm:text-lg">
        Click a preset below to see how our app transforms your home’s roofline for holidays, game days, and everyday evenings.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Interactive Roofline Preview Box -->
      <div class="lg:col-span-8 bg-slate-950 border border-slate-800 rounded-3xl p-4 sm:p-6 shadow-2xl relative overflow-hidden">
        
        <!-- Live Roofline Canvas Container -->
        <div class="relative rounded-2xl overflow-hidden aspect-[16/10] bg-slate-900 flex items-center justify-center border border-slate-800">
          <img 
            id="demo-house-img" 
            src="/images/IMG_8159.jpg" 
            alt="Simulated house roofline with permanent lighting" 
            class="w-full h-full object-cover transition-all duration-700 filter brightness-90"
          />

          <!-- Ambient dynamic glow overlay based on active preset -->
          <div id="dynamic-glow-overlay" class="absolute inset-0 pointer-events-none mix-blend-screen opacity-70 transition-all duration-500 bg-gradient-to-b from-amber-400/20 via-transparent to-transparent"></div>

          <!-- Simulated roofline light diodes with dynamic styling -->
          <div class="absolute top-8 inset-x-8 sm:inset-x-16 flex justify-between items-center pointer-events-none">
            {Array.from({ length: 18 }).map((_, i) => (
              <span 
                class="light-diode w-3 h-3 sm:w-4 sm:h-4 rounded-full transition-all duration-300 transform shadow-md"
                data-index={i}
              ></span>
            ))}
          </div>

          <!-- Bottom Status Badge -->
          <div class="absolute bottom-4 left-4 right-4 sm:left-6 sm:right-auto flex items-center gap-3 bg-slate-950/85 backdrop-blur-md border border-slate-700/80 px-4 py-2.5 rounded-xl shadow-lg">
            <div id="active-preset-indicator" class="w-3.5 h-3.5 rounded-full bg-amber-400 shadow-md"></div>
            <div>
              <p class="text-xs uppercase font-extrabold text-slate-400">Current Scene</p>
              <p id="active-preset-name" class="text-sm font-bold text-white">Warm White Architectural (3000K)</p>
            </div>
          </div>
        </div>

        <!-- System feature highlights underneath preview -->
        <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs text-slate-400 pt-2 border-t border-slate-800/80">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            <span>iOS & Android App</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Sunset Timers</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
            <span>16 Million Colors</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Cloud & Local Sync</span>
          </div>
        </div>

      </div>

      <!-- Right Controller Buttons / App Interface -->
      <div class="lg:col-span-4 space-y-4">
        <div class="bg-slate-950 border border-slate-800 rounded-3xl p-6 shadow-xl space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <span class="text-xs uppercase font-extrabold tracking-wider text-slate-400">Select Lighting Preset</span>
            <span class="text-xs text-slate-500 font-mono">App v3.4</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-2.5" id="preset-buttons">
            
            <button 
              type="button" 
              data-preset="warm" 
              class="preset-btn active w-full flex items-center justify-between p-3.5 rounded-xl border border-amber-500/50 bg-amber-500/10 text-white text-sm font-bold text-left transition-all hover:scale-[1.02]"
            >
              <div class="flex items-center gap-3">
                <span class="w-4 h-4 rounded-full bg-amber-300 shadow-md shadow-amber-300/50"></span>
                <span>Warm White (Architectural)</span>
              </div>
              <span class="text-xs text-amber-300 font-normal">Active</span>
            </button>

            <button 
              type="button" 
              data-preset="christmas" 
              class="preset-btn w-full flex items-center justify-between p-3.5 rounded-xl border border-slate-800 bg-slate-900 hover:bg-slate-850 text-slate-200 text-sm font-bold text-left transition-all hover:scale-[1.02]"
            >
              <div class="flex items-center gap-3">
                <div class="flex -space-x-1">
                  <span class="w-3.5 h-3.5 rounded-full bg-red-500"></span>
                  <span class="w-3.5 h-3.5 rounded-full bg-emerald-500"></span>
                </div>
                <span>Holiday Classic (Red & Green)</span>
              </div>
              <span class="text-xs text-slate-400 font-normal">Festive</span>
            </button>

            <button 
              type="button" 
              data-preset="seahawks" 
              class="preset-btn w-full flex items-center justify-between p-3.5 rounded-xl border border-slate-800 bg-slate-900 hover:bg-slate-850 text-slate-200 text-sm font-bold text-left transition-all hover:scale-[1.02]"
            >
              <div class="flex items-center gap-3">
                <div class="flex -space-x-1">
                  <span class="w-3.5 h-3.5 rounded-full bg-blue-700"></span>
                  <span class="w-3.5 h-3.5 rounded-full bg-lime-400"></span>
                </div>
                <span>Seahawks Game Day (Navy & Green)</span>
              </div>
              <span class="text-xs text-slate-400 font-normal">Game Day</span>
            </button>

            <button 
              type="button" 
              data-preset="july4" 
              class="preset-btn w-full flex items-center justify-between p-3.5 rounded-xl border border-slate-800 bg-slate-900 hover:bg-slate-850 text-slate-200 text-sm font-bold text-left transition-all hover:scale-[1.02]"
            >
              <div class="flex items-center gap-3">
                <div class="flex -space-x-1">
                  <span class="w-3.5 h-3.5 rounded-full bg-red-600"></span>
                  <span class="w-3.5 h-3.5 rounded-full bg-white"></span>
                  <span class="w-3.5 h-3.5 rounded-full bg-blue-600"></span>
                </div>
                <span>Patriotic (Red, White & Blue)</span>
              </div>
              <span class="text-xs text-slate-400 font-normal">4th of July</span>
            </button>

            <button 
              type="button" 
              data-preset="halloween" 
              class="preset-btn w-full flex items-center justify-between p-3.5 rounded-xl border border-slate-800 bg-slate-900 hover:bg-slate-850 text-slate-200 text-sm font-bold text-left transition-all hover:scale-[1.02]"
            >
              <div class="flex items-center gap-3">
                <div class="flex -space-x-1">
                  <span class="w-3.5 h-3.5 rounded-full bg-purple-600"></span>
                  <span class="w-3.5 h-3.5 rounded-full bg-amber-500"></span>
                </div>
                <span>Halloween (Purple & Amber)</span>
              </div>
              <span class="text-xs text-slate-400 font-normal">Autumn</span>
            </button>

          </div>

          <div class="pt-4 border-t border-slate-800 space-y-3">
            <p class="text-xs text-slate-400">
              Want custom animation speeds or individual bulb color control? We configure the mobile app during your installation.
            </p>
            <button 
              type="button" 
              data-open-quote-modal 
              class="w-full py-3.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-red-600/30 transition-all cursor-pointer text-center"
            >
              Request Free Estimate & In-Person Demo
            </button>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Presets definition
  const presets: Record<string, { name: string; colors: string[]; overlay: string; indicator: string }> = {
    warm: {
      name: "Warm White Architectural (3000K)",
      colors: ["#fef08a", "#fde047", "#fef08a", "#fef3c7"],
      overlay: "from-amber-300/30 via-transparent to-transparent",
      indicator: "#fde047"
    },
    christmas: {
      name: "Holiday Classic (Red & Emerald Green)",
      colors: ["#ef4444", "#10b981", "#ef4444", "#10b981"],
      overlay: "from-red-500/25 via-emerald-500/15 to-transparent",
      indicator: "#ef4444"
    },
    seahawks: {
      name: "Seahawks Game Day (Navy & Action Green)",
      colors: ["#1d4ed8", "#84cc16", "#1e3a8a", "#a3e635"],
      overlay: "from-blue-600/25 via-lime-500/20 to-transparent",
      indicator: "#84cc16"
    },
    july4: {
      name: "Patriotic (Red, White & Blue)",
      colors: ["#ef4444", "#ffffff", "#2563eb", "#ef4444"],
      overlay: "from-blue-600/20 via-red-500/15 to-transparent",
      indicator: "#2563eb"
    },
    halloween: {
      name: "Halloween (Spooky Purple & Pumpkin Amber)",
      colors: ["#9333ea", "#f97316", "#7e22ce", "#ea580c"],
      overlay: "from-purple-700/25 via-orange-600/20 to-transparent",
      indicator: "#9333ea"
    }
  };

  function applyPreset(presetKey: string) {
    const config = presets[presetKey];
    if (!config) return;

    // Update diodes
    const diodes = document.querySelectorAll<HTMLElement>('.light-diode');
    diodes.forEach((diode, idx) => {
      const color = config.colors[idx % config.colors.length];
      diode.style.backgroundColor = color;
      diode.style.boxShadow = `0 0 16px ${color}, 0 0 4px ${color}`;
    });

    // Update overlay
    const overlay = document.getElementById('dynamic-glow-overlay');
    if (overlay) {
      overlay.className = `absolute inset-0 pointer-events-none mix-blend-screen opacity-75 transition-all duration-500 bg-gradient-to-b ${config.overlay}`;
    }

    // Update status text & indicator
    const nameEl = document.getElementById('active-preset-name');
    const indicatorEl = document.getElementById('active-preset-indicator');
    if (nameEl) nameEl.textContent = config.name;
    if (indicatorEl) {
      indicatorEl.style.backgroundColor = config.indicator;
      indicatorEl.style.boxShadow = `0 0 10px ${config.indicator}`;
    }

    // Update active button state
    document.querySelectorAll('.preset-btn').forEach(btn => {
      const isThis = btn.getAttribute('data-preset') === presetKey;
      if (isThis) {
        btn.classList.add('border-amber-500/60', 'bg-amber-500/15', 'text-white');
        btn.classList.remove('border-slate-800', 'bg-slate-900', 'text-slate-200');
      } else {
        btn.classList.remove('border-amber-500/60', 'bg-amber-500/15', 'text-white');
        btn.classList.add('border-slate-800', 'bg-slate-900', 'text-slate-200');
      }
    });
  }

  // Initialize with warm white
  applyPreset('warm');

  // Bind click handlers
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-preset');
      if (key) applyPreset(key);
    });
  });
</script>
