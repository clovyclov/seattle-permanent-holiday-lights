---
// Reviews.astro - "DISCOVER WHAT OUR CUSTOMERS HAVE TO SAY ABOUT US"
const reviews = [
  {
    name: "Marcus V.",
    city: "Mill Creek, WA",
    rating: 5,
    date: "November 2025",
    text: "After slipping off a step ladder two years ago trying to hang traditional Christmas lights, I decided to go permanent. Seattle Permanent Holiday Lights did an unbelievable job matching our dark bronze trim. During the day you cannot see the track at all. At night, our house looks incredible."
  },
  {
    name: "Elena & David R.",
    city: "Seattle (Ballard), WA",
    rating: 5,
    date: "October 2025",
    text: "The team arrived right on time, completed our two-story roofline in a single afternoon, and cleaned up every scrap of wire. The smartphone app is super easy. We keep the warm white architectural setting on every evening and switched to Seahawks blue and green for Sunday games."
  },
  {
    name: "Travis H.",
    city: "Marysville, WA",
    rating: 5,
    date: "December 2025",
    text: "Worth every penny. We used to spend $1,500 every single winter hiring temporary light installers who left staple holes in our fascia. These permanent lights are built tough and weathered two heavy Pacific Northwest windstorms with zero issues."
  }
];
---

<section id="reviews" class="py-20 bg-slate-950 text-slate-100 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-wider">
        <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        5-Star Verified Customer Reviews
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white uppercase tracking-tight">
        Trusted Across the Puget Sound
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        Read honest feedback from Pacific Northwest homeowners who made the permanent switch.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reviews.map((rev) => (
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 flex flex-col justify-between hover:border-slate-700 transition-colors shadow-xl">
          
          <div class="space-y-4">
            <!-- 5 Stars SVG -->
            <div class="flex items-center gap-1 text-amber-400">
              {Array.from({ length: rev.rating }).map(() => (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <p class="text-sm text-slate-300 leading-relaxed italic">
              "{rev.text}"
            </p>
          </div>

          <div class="pt-6 border-t border-slate-800 mt-6 flex items-center justify-between">
            <div>
              <p class="font-bold text-white text-sm">{rev.name}</p>
              <p class="text-xs text-slate-400">{rev.city}</p>
            </div>
            <span class="text-xs text-slate-500 font-mono">{rev.date}</span>
          </div>

        </div>
      ))}
    </div>

    <!-- Google Review Prompt Box -->
    <div class="mt-14 max-w-xl mx-auto text-center bg-slate-900/60 border border-slate-800 p-6 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3 text-left">
        <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center font-black text-white text-lg">
          G
        </div>
        <div>
          <p class="text-sm font-bold text-white">Already a happy customer?</p>
          <p class="text-xs text-slate-400">Share your experience on Google Reviews.</p>
        </div>
      </div>
      <a 
        href="https://seattlepermanentholidaylights.com/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="shrink-0 px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs uppercase tracking-wider border border-slate-700 transition-colors"
      >
        Leave A Review
      </a>
    </div>

  </div>
</section>
