---
// Services.astro - Section 3 matching "OUR CORE LIGHTING SERVICES"
---

<section id="services" class="py-20 sm:py-24 bg-[#002b47] text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Centered Section Title -->
    <div class="text-center mb-12 sm:mb-16">
      <h2 class="font-['Montserrat',sans-serif] font-black text-3xl sm:text-4xl lg:text-5xl text-white uppercase tracking-tight">
        Our Core Lighting Services
      </h2>
    </div>

    <!-- 3 Cards Layout -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      
      <!-- Card 1: Residential -->
      <a href="/#gallery" class="group relative block rounded overflow-hidden shadow-lg border border-slate-700/50 hover:border-slate-400 transition-all duration-300">
        <div class="aspect-[4/3] w-full overflow-hidden bg-slate-900 relative">
          <img 
            src="/images/IMG_0238.jpg" 
            alt="Residential Permanent Holiday Lighting" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-90"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#001f35] via-[#001f35]/50 to-transparent"></div>
          
          <div class="absolute inset-0 p-6 flex flex-col justify-end text-center">
            <h3 class="font-['Montserrat',sans-serif] font-black text-xl sm:text-2xl text-white uppercase tracking-tight group-hover:text-amber-300 transition-colors">
              Residential Holiday Lighting
            </h3>
            <p class="text-xs sm:text-sm text-slate-200 mt-2 font-normal">
              Custom-fit to your roofline. Never climb a ladder again with year-round app control.
            </p>
          </div>
        </div>
      </a>

      <!-- Card 2: Commercial -->
      <a href="/#gallery" class="group relative block rounded overflow-hidden shadow-lg border border-slate-700/50 hover:border-slate-400 transition-all duration-300">
        <div class="aspect-[4/3] w-full overflow-hidden bg-slate-900 relative">
          <img 
            src="/images/IMG_1044.jpg" 
            alt="Commercial Permanent Lighting" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-90"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#001f35] via-[#001f35]/50 to-transparent"></div>
          
          <div class="absolute inset-0 p-6 flex flex-col justify-end text-center">
            <h3 class="font-['Montserrat',sans-serif] font-black text-xl sm:text-2xl text-white uppercase tracking-tight group-hover:text-amber-300 transition-colors">
              Commercial Lighting
            </h3>
            <p class="text-xs sm:text-sm text-slate-200 mt-2 font-normal">
              Draw in customers and elevate your storefront with programmable architectural lighting.
            </p>
          </div>
        </div>
      </a>

      <!-- Card 3: Bistro & Patio -->
      <a href="/#gallery" class="group relative block rounded overflow-hidden shadow-lg border border-slate-700/50 hover:border-slate-400 transition-all duration-300">
        <div class="aspect-[4/3] w-full overflow-hidden bg-slate-900 relative">
          <img 
            src="/images/IMG_1231.jpg" 
            alt="Bistro and Patio Lighting" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-90"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#001f35] via-[#001f35]/50 to-transparent"></div>
          
          <div class="absolute inset-0 p-6 flex flex-col justify-end text-center">
            <h3 class="font-['Montserrat',sans-serif] font-black text-xl sm:text-2xl text-white uppercase tracking-tight group-hover:text-amber-300 transition-colors">
              Bistro & Patio Lighting
            </h3>
            <p class="text-xs sm:text-sm text-slate-200 mt-2 font-normal">
              Warm, inviting glow for decks, patios, pergolas, and outdoor living areas.
            </p>
          </div>
        </div>
      </a>

    </div>

  </div>
</section>
