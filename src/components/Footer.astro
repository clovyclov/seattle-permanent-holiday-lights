---
// Footer.astro - Section 10 from reference screenshot
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#002b47] text-white pt-14 pb-8 border-t border-[#001f35]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Brand & Info -->
      <div class="md:col-span-7 space-y-4">
        <a href="/" class="flex items-center gap-3 group">
          <img 
            src="/images/logo.png" 
            alt="Seattle Permanent Holiday Lights Logo" 
            class="h-12 w-auto object-contain transition-transform group-hover:scale-105"
          />
          <span class="font-['Montserrat',sans-serif] font-black text-lg tracking-tight uppercase text-white">
            Seattle Permanent Holiday Lights
          </span>
        </a>

        <div class="space-y-2 text-xs sm:text-sm text-slate-200">
          <p class="flex items-center gap-2">
            <span class="text-[#cc181e] font-bold">Phone:</span>
            <a href="tel:4255996702" class="hover:underline font-bold text-white">(425) 599-6702</a>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-[#cc181e] font-bold">Email:</span>
            <a href="mailto:info@seattlepermanentholidaylights.com" class="hover:underline text-slate-200">info@seattlepermanentholidaylights.com</a>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-[#cc181e] font-bold">Hours:</span>
            <span>Monday – Saturday: 7:00 AM – 7:00 PM | Sunday: Closed</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-[#cc181e] font-bold">Coverage:</span>
            <span>Seattle, Mill Creek, Marysville, Bothell, Woodinville, Kirkland, Bellevue & Puget Sound</span>
          </p>
          <p class="pt-1 text-xs text-slate-300">
            Fully Licensed & Insured Exterior Lighting Contractor
          </p>
        </div>
      </div>

      <!-- Right Column: Map Thumbnail & Red Quote Button matching screenshot -->
      <div class="md:col-span-5 flex flex-col items-center md:items-end space-y-3">
        <span class="font-['Montserrat',sans-serif] font-black text-xs uppercase tracking-wider text-slate-200 self-center md:self-end">
          Our Service Area
        </span>
        
        <div class="w-full max-w-xs h-36 rounded overflow-hidden border border-slate-600 shadow-md bg-slate-800">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d343468.2052445839!2d-122.5029367175402!3d47.61314460599572!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5490102c93e83355%3A0x102565466944d59a!2sSeattle%2C%20WA!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus"
            width="100%"
            height="100%"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Service Area Map Thumbnail"
            class="w-full h-full opacity-90 hover:opacity-100 transition-opacity"
          ></iframe>
        </div>

        <div class="w-full max-w-xs pt-1">
          <button 
            type="button" 
            data-open-quote-modal 
            class="btn-fast-quote w-full text-xs py-3 text-center"
          >
            Get A Fast Quote
          </button>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 pt-6 border-t border-slate-700/60 text-center text-xs text-slate-400">
      <p>© {currentYear} Seattle Permanent Holiday Lights LLC. All Rights Reserved.</p>
    </div>
  </div>
</footer>
