---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteModal from '../components/QuoteModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Seattle Permanent Holiday Lights | Lighting Installation in Seattle",
  description = "The premier residential & commercial holiday lighting installation service in the Greater Seattle area. Custom-fitted LED lighting, zero ladder climbing, invisible by day, brilliant by night.",
  image = "/images/IMG_8159.jpg"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23cc181e'><path d='M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7zm-2 18h4v1c0 .55-.45 1-1 1h-2c-.55 0-1-.45-1-1v-1z'/></svg>" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="twitter:card" content="summary_large_image" />

    <!-- Google Fonts: Montserrat & Nunito (Exact fonts from inspiration) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white text-slate-700 antialiased font-['Nunito',sans-serif]">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <QuoteModal />

    <!-- Mobile Call / Quote Bar -->
    <div class="fixed bottom-0 left-0 right-0 z-40 bg-[#002b47]/95 border-t border-slate-700 p-2 flex items-center gap-2 md:hidden backdrop-blur-md">
      <a 
        href="tel:4255996702" 
        class="flex-1 flex items-center justify-center gap-1.5 py-2.5 px-2 rounded bg-white text-[#002b47] font-['Montserrat',sans-serif] font-black text-xs uppercase tracking-wide"
      >
        <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>(425) 599-6702</span>
      </a>
      <button 
        type="button" 
        data-open-quote-modal
        class="flex-1 flex items-center justify-center py-2.5 px-2 rounded bg-[#cc181e] hover:bg-[#b01318] text-white font-['Montserrat',sans-serif] font-black text-xs uppercase tracking-wider shadow"
      >
        <span>Get A Fast Quote</span>
      </button>
    </div>
  </body>
</html>
